# Supabase (required — Settings → API in your Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (has a default; docker-compose overrides this anyway — leave unset)
REDIS_URL=redis://localhost:6379/0

# Web Push (VAPID) — optional, needed only for push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# AI Research — required for AI reports / research features
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
AI_MODEL=anthropic/claude-opus-4-8
AI_MAX_TOKENS=20000

# Daily news briefing providers — optional until Denní briefing is enabled
MARKETAUX_API_KEY=
MARKETAUX_SYMBOLS_PER_REQUEST=1
MARKETAUX_ARTICLES_PER_REQUEST=3
MARKETAUX_REQUEST_DELAY_SECONDS=2
MARKETAUX_MAX_RETRIES=4
MARKETAUX_RETRY_BACKOFF_SECONDS=30
SEC_USER_AGENT=DeepStock daily briefing contact@example.com

# Twitter scraping — optional
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
PROXY_URL=

# App
DEBUG=false
