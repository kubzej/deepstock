# Supabase (required — Settings → API in your Supabase project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (has a default; docker-compose overrides this anyway — leave unset)
REDIS_URL=redis://localhost:6379/0

# Web Push (VAPID) — optional, needed only for push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=

# Cron job authentication — optional, needed only for scheduled jobs
CRON_SECRET=

# AI Research — required for AI reports / research features
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
AI_MODEL=anthropic/claude-opus-4-8
AI_MAX_TOKENS=20000

# Twitter scraping — optional
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
PROXY_URL=

# App
DEBUG=false
